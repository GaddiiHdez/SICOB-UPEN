// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Bien {
  id                Int          @id @default(autoincrement())
  codigo_inventario String       @unique
  numero_serie      String       @unique
  marca             String
  modelo            String
  estado            String       // "Activo", "Mantenimiento", "En reserva", "Baja"
  descripcion       String?      @db.Text
  especificaciones     Json         // Almacenamiento flexible de atributos específicos (ej. RAM, procesador, autonomía)
  fecha_adquisicion    DateTime?
  programa_adquisicion String?      // Programa o fondo de compra (ej. "Programa U079")
  valor_estimado       Float?
  imagen_url           String?      @db.Text
  eliminado            Boolean      @default(false)  // Soft delete: true = dado de baja lógicamente
  eliminadoEn          DateTime?                     // Fecha en que se dio de baja
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // Relaciones
  categoriaId       Int
  categoria         Categoria    @relation(fields: [categoriaId], references: [id])
  ubicacionId       Int
  ubicacion         Ubicacion    @relation(fields: [ubicacionId], references: [id])
  departamentoId    Int?         // Departamento administrativo
  departamento      Departamento? @relation(fields: [departamentoId], references: [id])
  asignaciones      Asignacion[]
  mantenimientos    Mantenimiento[]
  vales             ValeSalida[] @relation("ValesBienes")
  movimientosConsumibles MovimientoConsumible[]
  labIncidentes     LabIncidente[]
  softwareInstalaciones SoftwareInstalacion[]

  // Índices para acelerar las consultas más frecuentes
  @@index([eliminado, estado])
  @@index([eliminado, categoriaId])
  @@index([eliminado, departamentoId])
}

model Categoria {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique // "Cómputo", "Monitores", "Redes", "Drones", "Cámaras", etc.
  descripcion String?  @db.Text
  icono       String?  @default("🏷️")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bienes      Bien[]
}

model Ubicacion {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique // "Laboratorio A", "Aula 5", "Biblioteca", etc.
  edificio    String?  // "Edificio A", "Edificio B", etc.
  encargado   String?  // Nombre del docente o administrativo encargado de la LLAVE/Espacio
  icono       String?  @default("🏫")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bienes      Bien[]
  departamentos Departamento[]
  inmobiliarios Inmobiliario[]
  consumibles   Consumible[]
  laboratorio   Laboratorio?
}

model Departamento {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique // "Ciencias Básicas", "Ingeniería", "Rectoría", etc.
  jefe        String?  // Nombre del titular o jefe de departamento
  icono       String?  @default("🏢")
  ubicacionId Int?     // Ubicación física de la oficina principal
  ubicacion   Ubicacion? @relation(fields: [ubicacionId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bienes      Bien[]
  personal    Personal[]
  inmobiliarios Inmobiliario[]
  movimientosConsumibles MovimientoConsumible[]
}

model Personal {
  id             Int          @id @default(autoincrement())
  nombre         String
  correo         String       @unique
  puesto         String?      // "Docente", "Jefe de Departamento", "Secretaria", etc.
  noRegistrado   Boolean      @default(false)
  departamentoId Int?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])
  asignaciones   Asignacion[]
  vales          ValeSalida[]
  inmobiliarios  Inmobiliario[]
  movimientosConsumibles MovimientoConsumible[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Usuario {
  id            Int          @id @default(autoincrement())
  nombre        String
  correo        String       @unique
  rol           String       // "ADMINISTRADOR" o "USUARIO"
  password_hash String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

/// Token temporal de restablecimiento de contraseña.
/// El administrador lo genera desde Configuración y lo comparte con el usuario.
model PasswordReset {
  id        Int      @id @default(autoincrement())
  correo    String
  token     String
  expiresAt DateTime
  usado     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([correo])
  @@index([token])
}

model Asignacion {
  id               Int       @id @default(autoincrement())
  fecha_asignacion DateTime  @default(now())
  fecha_retorno    DateTime?
  observaciones    String?   @db.Text
  estado_entrega   String    // Estado en el que se entregó ("Activo", "Bueno", etc.)
  firma            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relaciones
  bienId           Int
  bien             Bien      @relation(fields: [bienId], references: [id])
  personalId       Int
  personal         Personal  @relation(fields: [personalId], references: [id])

  @@index([bienId, fecha_retorno])
  @@index([personalId])
}

model Configuracion {
  id          Int      @id @default(autoincrement())
  clave       String   @unique // Ej. "formato_codigo_inventario"
  valor       String   // Ej. "UPEN-{CAT}-{YEAR}-{CORRELATIVO}"
  descripcion String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Mantenimiento {
  id                    Int           @id @default(autoincrement())
  bienId                Int
  bien                  Bien          @relation(fields: [bienId], references: [id], onDelete: Cascade)
  tipo                  String        // "Preventivo" o "Correctivo"
  descripcion           String        @db.Text
  costo                 Float?
  fecha_mantenimiento   DateTime      @default(now())
  proximo_mantenimiento DateTime? // Fecha programada para el siguiente mantenimiento preventivo
  tecnico_encargado     String?   // Nombre de quien realiza la revisión
  estado                String        // "Programado", "En proceso", "Completado"
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Relación con reportes de incidentes
  incidenteId           Int?
  incidente             LabIncidente? @relation(fields: [incidenteId], references: [id], onDelete: SetNull)
}

model ValeSalida {
  id               Int       @id @default(autoincrement())
  folio            String    @unique
  personalId       Int
  personal         Personal  @relation(fields: [personalId], references: [id])
  bienes           Bien[]    @relation("ValesBienes")
  fecha_salida     DateTime  @default(now())
  fecha_estimada   DateTime
  fecha_retorno    DateTime?
  motivo           String    @db.Text
  estado           String    @default("PENDIENTE") // "PENDIENTE", "DEVUELTO", "VENCIDO"
  observaciones    String?   @db.Text
  firma            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model CategoriaInmobiliario {
  id            Int            @id @default(autoincrement())
  nombre        String         @unique // "Sillas", "Escritorios", etc.
  descripcion   String?        @db.Text
  icono         String?        @default("🪑")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  inmobiliarios Inmobiliario[]
}

model Inmobiliario {
  id                      Int                   @id @default(autoincrement())
  codigo_inventario       String                @unique
  descripcion             String                @db.Text
  marca                   String?
  modelo                  String?
  estado                  String                // "Nuevo", "Bueno", "Regular", "Malo", "Baja"
  valor_estimado          Float?
  fecha_adquisicion       DateTime?
  programa_adquisicion    String?               // Programa de compra (ej. "Programa U079")
  observaciones           String?               @db.Text
  eliminado               Boolean               @default(false)
  eliminadoEn             DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  // Relaciones
  categoriaInmobiliarioId Int
  categoriaInmobiliario   CategoriaInmobiliario @relation(fields: [categoriaInmobiliarioId], references: [id])
  ubicacionId             Int
  ubicacion               Ubicacion             @relation(fields: [ubicacionId], references: [id])
  departamentoId          Int?
  departamento            Departamento?         @relation(fields: [departamentoId], references: [id])
  personalId              Int?                  // Custodio responsable actual
  personal                Personal?             @relation(fields: [personalId], references: [id])

  @@index([eliminado, estado])
  @@index([eliminado, ubicacionId])
  @@index([eliminado, categoriaInmobiliarioId])
}

model CategoriaConsumible {
  id            Int          @id @default(autoincrement())
  nombre        String       @unique // "Papelería", "Tóners", etc.
  descripcion   String?      @db.Text
  icono         String?      @default("📦")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  consumibles   Consumible[]
}

model Consumible {
  id                    Int                   @id @default(autoincrement())
  nombre                String                @unique
  marca                 String?
  modelo                String?
  stock_actual          Int                   @default(0)
  stock_minimo          Int                   @default(5)
  unidad_medida         String                @default("Pieza") // "Pieza", "Caja", etc.
  color                 String?               // "Negro", "Cyan", "Magenta", "Amarillo", "Tricolor", "N/A"
  compatibilidad        String?               // Impresoras compatibles
  rendimiento           Int?                  // Rendimiento de páginas
  observaciones         String?               @db.Text
  eliminado             Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  // Relaciones
  categoriaConsumibleId Int
  categoriaConsumible   CategoriaConsumible   @relation(fields: [categoriaConsumibleId], references: [id])
  ubicacionId           Int?                  // Dónde se almacena
  ubicacion             Ubicacion?            @relation(fields: [ubicacionId], references: [id])
  movimientos           MovimientoConsumible[]
}

model MovimientoConsumible {
  id             Int          @id @default(autoincrement())
  tipo           String       // "ENTRADA" o "SALIDA"
  cantidad       Int
  fecha          DateTime     @default(now())
  motivo         String?      @db.Text // Ej. "Surtido de almacén", "Entrega a docente"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relaciones
  consumibleId   Int
  consumible     Consumible   @relation(fields: [consumibleId], references: [id], onDelete: Cascade)
  personalId     Int?         // Custodio / Persona que recibe (para salidas)
  personal       Personal?    @relation(fields: [personalId], references: [id])
  departamentoId Int?         // Departamento de destino
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])
  usuarioId      Int?         // Usuario que registra el movimiento (opcional)
  bienId         Int?         // Impresora asociada al cambio
  bien           Bien?        @relation(fields: [bienId], references: [id], onDelete: SetNull)

  @@index([consumibleId])
  @@index([bienId])
}

model Laboratorio {
  id            Int            @id @default(autoincrement())
  nombre        String         @unique
  codigo        String?        // Ej: "LAB-COMP-01"
  capacidad     Int            @default(30)
  so            String?        // Windows 11, Ubuntu, macOS, etc.
  software      String?        @db.Text
  red           String?        // WiFi, Ethernet 1Gbps, etc.
  observaciones String?        @db.Text
  layout        Json?          // Dimensiones, disposición de mesas, sillas, etc.
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relaciones
  ubicacionId   Int?           @unique
  ubicacion     Ubicacion?     @relation(fields: [ubicacionId], references: [id], onDelete: SetNull)
  incidentes    LabIncidente[]
  softwareInstalaciones SoftwareInstalacion[]
}

model LabIncidente {
  id              Int             @id @default(autoincrement())
  titulo          String
  descripcion     String          @db.Text
  estado          String          @default("PENDIENTE") // "PENDIENTE", "RESUELTO"
  prioridad       String          @default("MEDIA")     // "BAJA", "MEDIA", "ALTA"
  categoria       String?                               // "Hardware", "Software", "Red", "Otros"
  reportadoPor    String?
  fechaReporte    DateTime        @default(now())
  fechaResolucion DateTime?
  comentarios     String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relaciones
  laboratorioId   Int
  laboratorio     Laboratorio     @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)
  bienId          Int?
  bien            Bien?           @relation(fields: [bienId], references: [id], onDelete: SetNull)
  mantenimientos  Mantenimiento[]
}

model Software {
  id                  Int                  @id @default(autoincrement())
  nombre              String               @unique
  version             String?
  fabricante          String?
  tipoLicencia        String               // "Libre", "Propietaria", "OEM", "Educativa", "Suscripción"
  licenciaKey         String?              @db.Text
  vencimientoLicencia DateTime?
  sitioWeb            String?
  descripcion         String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  instalaciones       SoftwareInstalacion[]
}

model SoftwareInstalacion {
  id               Int          @id @default(autoincrement())
  softwareId       Int
  software         Software     @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  bienId           Int?         // Si se instala por equipo individual
  bien             Bien?        @relation(fields: [bienId], references: [id], onDelete: Cascade)
  laboratorioId    Int?         // Si se instala para todo un laboratorio
  laboratorio      Laboratorio? @relation(fields: [laboratorioId], references: [id], onDelete: Cascade)
  
  // Licencias individuales por equipo
  licenciaKey         String?   @db.Text
  vencimientoLicencia DateTime?

  fechaInstalacion DateTime     @default(now())
  observaciones    String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([softwareId, bienId])
  @@unique([softwareId, laboratorioId])
}

